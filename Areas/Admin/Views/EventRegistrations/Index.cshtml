@model IEnumerable<VinhuniEvent.Models.EventRegistration>
@{
    ViewData["Title"] = "Quản lý đăng ký sự kiện";
    Layout = "~/Areas/Admin/Views/Shared/_Layout.cshtml";

    // Xử lý dữ liệu C# ở đầu trang
    var groupedEvents = Model
        .Where(e => e.Event != null)
        .GroupBy(e => e.Event)
        .Select(g => new
        {
            Event = g.Key,
            TotalRegistrations = g.Count(),
            // Logic trạng thái: Nếu thời gian kết thúc sau thời điểm hiện tại là Active
            IsRunning = g.Key.EndTime > DateTime.Now
        })
        .OrderByDescending(x => x.Event.CreatedDate)
        .ToList();

    int totalEvents = groupedEvents.Count();
    int activeEvents = groupedEvents.Count(e => e.IsRunning);
    int totalRegistrations = groupedEvents.Sum(e => e.TotalRegistrations);
}

<style>
    .page-header {
        padding: 1.5rem 0;
        margin-bottom: 1.5rem;
        border-bottom: 2px solid #2a5298;
    }

    .page-title {
        color: #2a5298;
        font-size: 1.5rem;
        font-weight: 600;
        margin: 0;
    }

    .page-description {
        color: #6c757d;
        font-size: 0.9rem;
    }

    .filter-box {
        border: 1px solid #ddd;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        background: white;
        border-radius: 8px;
    }

    .filter-label {
        font-weight: 600;
        font-size: 0.85rem;
        color: #495057;
        margin-bottom: 0.5rem;
    }

    .stats-card {
        border: 1px solid #dee2e6;
        padding: 1.2rem;
        background: white;
        margin-bottom: 1.5rem;
        border-radius: 8px;
    }

    .stat-number {
        font-size: 1.8rem;
        font-weight: 700;
        color: #2a5298;
    }

    .stat-label {
        font-size: 0.75rem;
        color: #6c757d;
        text-transform: uppercase;
        font-weight: 700;
    }

    .custom-table thead th {
        background: #f8f9fa;
        color: #495057;
        font-size: 0.8rem;
        text-transform: uppercase;
        border-bottom: 2px solid #dee2e6;
    }

    .event-thumbnail {
        width: 60px;
        height: 60px;
        object-fit: cover;
        border-radius: 6px;
    }

    .event-title {
        font-weight: 600;
        color: #2a5298;
        text-decoration: none;
    }

    .badge-active {
        background: #d4edda;
        color: #155724;
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .badge-inactive {
        background: #f8d7da;
        color: #721c24;
        padding: 0.3rem 0.6rem;
        border-radius: 4px;
        font-size: 0.75rem;
        font-weight: 600;
    }

    .participant-count {
        background: #e3f2fd;
        color: #1976d2;
        padding: 0.3rem 0.7rem;
        border-radius: 20px;
        font-weight: 600;
        font-size: 0.85rem;
    }

    .action-btn {
        padding: 0.3rem 0.6rem;
        font-size: 0.8rem;
        border: 1px solid #0d6efd;
        color: #0d6efd;
        border-radius: 4px;
        text-decoration: none;
        transition: 0.2s;
    }

        .action-btn:hover {
            background: #0d6efd;
            color: white;
        }

    .no-result {
        text-align: center;
        padding: 3rem;
        display: none;
    }
</style>

<div class="container-fluid px-4">
    <div class="page-header">
        <h1 class="page-title"><i class="fa-solid fa-calendar-check me-2"></i>Quản lý đăng ký sự kiện</h1>
        <p class="page-description">Theo dõi danh sách và số lượng sinh viên tham gia các hoạt động.</p>
    </div>

    <div class="stats-card shadow-sm">
        <div class="row text-center">
            <div class="col-md-4 border-end">
                <div class="stat-number">@totalEvents</div>
                <div class="stat-label">Tổng số sự kiện</div>
            </div>
            <div class="col-md-4 border-end">
                <div class="stat-number text-success">@activeEvents</div>
                <div class="stat-label">Đang diễn ra</div>
            </div>
            <div class="col-md-4">
                <div class="stat-number text-primary">@totalRegistrations</div>
                <div class="stat-label">Tổng lượt đăng ký</div>
            </div>
        </div>
    </div>

    <div class="filter-box shadow-sm">
        <div class="row g-3">
            <div class="col-md-6">
                <label class="filter-label">Tìm kiếm sự kiện</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="fa-solid fa-magnifying-glass text-muted"></i></span>
                    <input type="text" id="searchEvent" class="form-control" placeholder="Nhập tên sự kiện hoặc mã..." onkeyup="filterTable()">
                </div>
            </div>
            <div class="col-md-3">
                <label class="filter-label">Trạng thái thời gian</label>
                <select id="filterStatus" class="form-select" onchange="filterTable()">
                    <option value="">Tất cả</option>
                    <option value="active">Đang diễn ra</option>
                    <option value="inactive">Đã kết thúc</option>
                </select>
            </div>
            <div class="col-md-3 d-flex align-items-end">
                <button onclick="resetFilters()" class="btn btn-outline-secondary w-100">
                    <i class="fa-solid fa-arrows-rotate me-1"></i> Làm mới bộ lọc
                </button>
            </div>
        </div>
    </div>

    <div class="table-responsive bg-white shadow-sm rounded">
        <table class="table table-hover custom-table mb-0" id="eventsTable">
            <thead>
                <tr>
                    <th class="text-center" style="width: 5%">STT</th>
                    <th style="width: 10%">Ảnh</th>
                    <th style="width: 20%">Sự kiện</th>
                    <th style="width: 10%">Ngày tạo</th>
                    <th style="width: 10%">Ngày bắt đầu</th>
                    <th style="width: 10%">Ngày kết thúc</th>
                    <th class="text-center" style="width: 10%">Số lượng</th>
                    <th class="text-center" style="width: 15%">Trạng thái</th>
                    <th class="text-center" style="width: 10%">Thao tác</th>
                </tr>
            </thead>
            <tbody id="tableBody">
                @{
                    int stt = 1;
                }
                @foreach (var item in groupedEvents)
                {
                    var ev = item.Event;
                    var statusKey = item.IsRunning ? "active" : "inactive";

                    <tr data-status="@statusKey">
                        <td class="text-center fw-bold text-muted stt-column">@(stt++)</td>
                        <td>
                            <img src="~/main/img/events/@ev.Image" class="event-thumbnail border"
                                 onerror="this.src='/main/img/events/default.jpg'" />
                        </td>
                        <td>
                            <a asp-action="ByEvent" asp-route-id="@ev.EventId" class="event-title d-block">@ev.Title</a>
                            <small class="text-muted">Mã: #@ev.EventId</small>
                        </td>
                        <td>
                            <i class="fa-regular fa-clock me-1 text-muted"></i>
                            @ev.CreatedDate?.ToString("dd/MM/yyyy")
                        </td>
                        <td>
                            <i class="fa-regular fa-clock me-1 text-muted"></i>
                            @ev.StartTime
                        </td>
                        <td>
                            <i class="fa-regular fa-clock me-1 text-muted"></i>
                            @ev.EndTime
                        </td>
                        <td class="text-center">
                            <span class="participant-count">@item.TotalRegistrations</span>
                        </td>
                        <td class="text-center">
                            @if (item.IsRunning)
                            {
                                <span class="badge-active"><i class="fa-solid fa-circle-play me-1"></i>Đang diễn ra</span>
                            }
                            else
                            {
                                <span class="badge-inactive"><i class="fa-solid fa-circle-stop me-1"></i>Đã kết thúc</span>
                            }
                        </td>
                        <td class="text-center">
                            <a asp-action="ByEvent" asp-route-id="@ev.EventId" class="action-btn" title="Xem danh sách sinh viên">
                                <i class="fa-solid fa-users-viewfinder me-1"></i>Chi tiết
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
        <div id="noResult" class="no-result">
            <i class="fa-solid fa-magnifying-glass fa-3x mb-3 text-light"></i>
            <p class="text-muted">Không tìm thấy dữ liệu phù hợp với yêu cầu lọc.</p>
        </div>
    </div>
</div>

<script>
    function filterTable() {
        const inputEvent = document.getElementById("searchEvent").value.toLowerCase();
        const filterStatus = document.getElementById("filterStatus").value;
        const rows = document.querySelectorAll("#tableBody tr");
        const noResult = document.getElementById("noResult");

        let visibleCount = 1;
        let hasResult = false;

        rows.forEach(row => {
            const title = row.querySelector(".event-title").innerText.toLowerCase();
            const eventId = row.querySelector(".text-muted").innerText.toLowerCase();
            const status = row.getAttribute("data-status");

            const matchText = title.includes(inputEvent) || eventId.includes(inputEvent);
            const matchStatus = filterStatus === "" || status === filterStatus;

            if (matchText && matchStatus) {
                row.style.display = "";
                row.querySelector(".stt-column").innerText = visibleCount++;
                hasResult = true;
            } else {
                row.style.display = "none";
            }
        });

        noResult.style.display = hasResult ? "none" : "block";
    }

    function resetFilters() {
        document.getElementById("searchEvent").value = "";
        document.getElementById("filterStatus").value = "";
        filterTable();
    }
</script>