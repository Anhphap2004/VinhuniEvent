@model VinhuniEvent.Models.User
@{
    ViewData["Title"] = "Hồ sơ sinh viên";
    var totalRegistered = Model.EventRegistrations?.Count ?? 0;
    var totalPresent = Model.Attendances?.Count(a => a.IsPresent == true) ?? 0;
    var totalAbsent = totalRegistered - totalPresent;
    var rate = totalRegistered == 0 ? 0 : (double)totalPresent / totalRegistered * 100;
}

<style>
    /* Reset font to sans-serif */
    * {
        font-family: "Fredoka", "Poppins", sans-serif !important;
    }

    /* Tet Theme for Profile Page */
    :root {
        --tet-red: #D32F2F;
        --tet-gold: #FDB913;
    }

    .profile-wrapper {
        background: linear-gradient(135deg, #FFF9E6 0%, #FFE8CC 100%);
        padding: 40px 0;
        min-height: calc(100vh - 200px);
    }

    .profile-container {
        max-width: 1140px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .back-button {
        display: inline-block;
        padding: 10px 25px;
        background: linear-gradient(135deg, var(--tet-red), var(--tet-gold));
        color: white !important;
        text-decoration: none;
        border-radius: 8px;
        margin-bottom: 25px;
        font-size: 14px;
        font-weight: 700;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        box-shadow: 0 4px 12px rgba(211, 47, 47, 0.2);
    }

    .back-button:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(211, 47, 47, 0.3);
        color: white !important;
        text-decoration: none;
    }

    /* --- Styles mới cho Profile Card gọn đẹp --- */
    .profile-card {
        background: white;
        border-radius: 16px;
        padding: 30px;
        margin-bottom: 25px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.05); /* Bóng đổ mềm mại hơn */
        display: flex; /* Dùng Flexbox để chia cột */
        align-items: center;
        gap: 40px;
    }

    /* Cột trái: Avatar & Tên */
    .profile-left {
        text-align: center;
        min-width: 220px;
        border-right: 1px solid #f0f0f0;
        padding-right: 40px;
    }

    .user-avatar {
        width: 120px;
        height: 120px;
        background: linear-gradient(135deg, var(--tet-red), var(--tet-gold));
        color: white;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        font-size: 48px;
        font-weight: 700;
        margin-bottom: 15px;
        box-shadow: 0 5px 15px rgba(211, 47, 47, 0.2);
    }

    .user-name {
        font-size: 22px;
        font-weight: 700;
        color: #2c3e50;
        margin-bottom: 5px;
    }

    .user-code {
        display: inline-block;
        background: #FEF3F3;
        color: var(--tet-red);
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 600;
    }

    /* Cột phải: Lưới thông tin chi tiết */
    .profile-right {
        flex-grow: 1;
        display: grid;
        grid-template-columns: 1fr 1fr; /* Chia 2 cột đều nhau */
        gap: 25px;
    }

    .info-item {
        display: flex;
        align-items: flex-start;
        gap: 15px;
    }

    .info-icon {
        width: 40px;
        height: 40px;
        background: #FFF9E6;
        color: var(--tet-gold);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
    }

    .info-content {
        display: flex;
        flex-direction: column;
    }

    .info-label {
        font-size: 11px;
        text-transform: uppercase;
        color: #95a5a6;
        font-weight: 600;
        margin-bottom: 4px;
        letter-spacing: 0.5px;
    }

    .info-value {
        font-size: 15px;
        color: #2c3e50;
        font-weight: 500;
    }

    /* Responsive cho điện thoại */
    @@media (max-width: 768px) {
        .profile-card {
            flex-direction: column; /* Xếp chồng dọc */
            padding: 20px;
            gap: 20px;
        }

        .profile-left {
            border-right: none;
            border-bottom: 1px solid #f0f0f0;
            padding-right: 0;
            padding-bottom: 20px;
            width: 100%;
        }

        .profile-right {
            grid-template-columns: 1fr; /* 1 cột duy nhất */
            width: 100%;
            gap: 20px;
        }
    }

    .stats-row {
        display: flex;
        flex-wrap: wrap;
        margin: 0 -10px 25px -10px;
    }

    .stat-col {
        flex: 0 0 25%;
        max-width: 25%;
        padding: 0 10px;
    }

    .stat-box {
        background: white;
        padding: 25px 20px;
        border-radius: 12px;
        text-align: center;
        box-shadow: 0 6px 16px rgba(211, 47, 47, 0.08);
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        border-top: 4px solid var(--tet-gold);
    }

    .stat-box:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 10px 24px rgba(211, 47, 47, 0.15);
    }

    .stat-box-number {
        font-size: 34px;
        font-weight: 800;
        background: linear-gradient(135deg, var(--tet-red), var(--tet-gold));
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 8px;
        line-height: 1;
    }

    .stat-box.green .stat-box-number {
        background: linear-gradient(135deg, var(--tet-gold), #FFD700);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-box.red .stat-box-number {
        background: linear-gradient(135deg, var(--tet-red), #E8463D);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-box.orange .stat-box-number {
        background: linear-gradient(135deg, var(--tet-gold), #FFB700);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .stat-box-label {
        font-size: 13px;
        color: #7f8c8d;
        font-weight: 500;
    }

    /* Tab Navigation */
    .tab-navigation {
        display: flex;
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 16px rgba(211, 47, 47, 0.08);
        margin-bottom: 25px;
    }

    .tab-button {
        flex: 1;
        padding: 18px 20px;
        background: white;
        border: none;
        color: #7f8c8d;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s;
        border-bottom: 3px solid transparent;
        text-align: center;
    }

    .tab-button:hover {
        background: linear-gradient(135deg, rgba(211, 47, 47, 0.05), rgba(253, 185, 19, 0.05));
        color: var(--tet-red);
    }

    .tab-button.active {
        color: white;
        border-bottom-color: var(--tet-gold);
        background: linear-gradient(135deg, var(--tet-red), #C8102E);
    }

    .tab-content-area {
        display: none;
    }

    .tab-content-area.active {
        display: block;
        animation: fadeIn 0.3s;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .table-card {
        background: white;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 6px 16px rgba(211, 47, 47, 0.08);
        margin-bottom: 35px;
    }

    .custom-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

    .custom-table thead {
        background: #f8f9fa;
    }

    .custom-table th {
        padding: 16px 18px;
        text-align: left;
        font-weight: 700;
        color: white;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        border-bottom: 2px solid var(--tet-gold);
        background: linear-gradient(135deg, var(--tet-red), #C8102E);
    }

    .custom-table td {
        padding: 16px 18px;
        border-bottom: 1px solid #f0f0f0;
        font-size: 14px;
        color: #2c3e50;
    }

    .custom-table tbody tr:last-child td {
        border-bottom: none;
    }

    .custom-table tbody tr:hover {
        background: linear-gradient(135deg, rgba(211, 47, 47, 0.02), rgba(253, 185, 19, 0.02));
    }

    .status-badge {
        display: inline-block;
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .status-badge.primary {
        background: linear-gradient(135deg, rgba(211, 47, 47, 0.1), rgba(211, 47, 47, 0.05));
        color: var(--tet-red);
        border: 1px solid var(--tet-red);
    }

    .status-badge.success {
        background: linear-gradient(135deg, rgba(253, 185, 19, 0.1), rgba(253, 185, 19, 0.05));
        color: #B8860B;
        border: 1px solid var(--tet-gold);
    }

    .status-badge.danger {
        background: linear-gradient(135deg, rgba(211, 47, 47, 0.15), rgba(211, 47, 47, 0.08));
        color: white;
        background: linear-gradient(135deg, var(--tet-red), #E8463D);
        border: none;
    }

    .empty-box {
        text-align: center;
        padding: 70px 20px;
        color: #bdc3c7;
    }

    .empty-box-icon {
        font-size: 52px;
        margin-bottom: 18px;
        opacity: 0.4;
    }

    .empty-box p {
        font-size: 15px;
        margin: 0;
    }

    .time-small {
        color: #95a5a6;
        font-size: 12px;
        display: block;
        margin-top: 3px;
    }

    @@media (max-width: 991px) {
        .stat-col {
            flex: 0 0 50%;
            max-width: 50%;
            margin-bottom: 15px;
        }

        .info-col {
            flex: 0 0 100%;
            max-width: 100%;
        }
    }

    @@media (max-width: 767px) {
        .profile-wrapper {
            padding: 20px 0;
        }

        .profile-card {
            padding: 25px 20px;
        }

        .user-avatar {
            width: 90px;
            height: 90px;
            font-size: 36px;
        }

        .profile-header-section h1 {
            font-size: 22px;
        }

        .stat-col {
            flex: 0 0 50%;
            max-width: 50%;
        }

        .stat-box {
            padding: 20px 15px;
        }

        .stat-box-number {
            font-size: 28px;
        }

        .tab-button {
            padding: 15px 10px;
            font-size: 14px;
        }

        .table-card {
            overflow-x: auto;
        }

        .custom-table {
            min-width: 600px;
        }

        .custom-table th,
        .custom-table td {
            padding: 12px 10px;
            font-size: 13px;
        }
    }
</style>

<div class="profile-wrapper">
    <div class="profile-container">
        <a href="javascript:history.back()" class="back-button">← Quay lại</a>

        <!-- Profile Information -->
        <div class="profile-card">
            <div class="profile-left">
                <div class="user-avatar">@Model.FullName?.FirstOrDefault()</div>
                <div class="user-name">@Model.FullName</div>
                <span class="user-code">SV: @Model.StudentCode</span>
            </div>

            <div class="profile-right">
                <div class="info-item">
                    <div class="info-icon">📧</div>
                    <div class="info-content">
                        <span class="info-label">Email liên hệ</span>
                        <span class="info-value">@Model.Email</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">📞</div>
                    <div class="info-content">
                        <span class="info-label">Điện thoại</span>
                        <span class="info-value">@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Chưa cập nhật" : Model.PhoneNumber)</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">🎓</div>
                    <div class="info-content">
                        <span class="info-label">Khoa & Ngành</span>
                        <span class="info-value">@Model.Faculty</span>
                        <span style="font-size: 13px; color: #7f8c8d;">@Model.Major</span>
                    </div>
                </div>

                <div class="info-item">
                    <div class="info-icon">🎂</div>
                    <div class="info-content">
                        <span class="info-label">Ngày sinh</span>
                        <span class="info-value">@(Model.BirthDate?.ToString("dd/MM/yyyy") ?? "--/--/----")</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Statistics -->
        <div class="stats-row">
            <div class="stat-col">
                <div class="stat-box">
                    <div class="stat-box-number">@totalRegistered</div>
                    <div class="stat-box-label">Đã đăng ký</div>
                </div>
            </div>
            <div class="stat-col">
                <div class="stat-box green">
                    <div class="stat-box-number">@totalPresent</div>
                    <div class="stat-box-label">Có mặt</div>
                </div>
            </div>
            <div class="stat-col">
                <div class="stat-box red">
                    <div class="stat-box-number">@totalAbsent</div>
                    <div class="stat-box-label">Vắng</div>
                </div>
            </div>
            <div class="stat-col">
                <div class="stat-box orange">
                    <div class="stat-box-number">@rate.ToString("0")%</div>
                    <div class="stat-box-label">Tỉ lệ tham gia</div>
                </div>
            </div>
        </div>

        <!-- Tab Navigation -->
        <div class="tab-navigation">
            <button class="tab-button active" onclick="switchTab(event, 'tab-registered')">
                📅 Sự kiện đã đăng ký
            </button>
            <button class="tab-button" onclick="switchTab(event, 'tab-attendance')">
                📋 Lịch sử điểm danh
            </button>
            <button class="tab-button" onclick="switchTab(event, 'tab-certificates')">
                🏅 Giấy chứng nhận
            </button>
        </div>

        <!-- Tab Content: Registered Events -->
        <div id="tab-registered" class="tab-content-area active">
            <div class="table-card">
                @if (Model.EventRegistrations != null && Model.EventRegistrations.Any())
                {
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Tên sự kiện</th>
                                <th>Thời gian</th>
                                <th>Trạng thái</th>
                                <th>Ảnh check-in</th> @* Cột này chỉ để upload ảnh lưu niệm *@
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in Model.EventRegistrations)
                            {
                                var currentImg = Model.Attendances?.FirstOrDefault(a => a.EventId == r.EventId)?.CheckInImage;
                                <tr>
                                    <td>@r.Event?.Title</td>
                                    <td>@r.Event?.StartTime.ToString("dd/MM/yyyy")</td>
                                    <td><span class="status-badge primary">@r.Status</span></td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(currentImg))
                                        {
                                            <div style="position: relative; display: inline-block;">
                                                <img src="@currentImg" style="width: 50px; height: 40px; border-radius: 5px; object-fit: cover; border: 2px solid var(--tet-gold);" />
                                                <button onclick="triggerUpload(@r.EventId)" style="position: absolute; bottom: -5px; right: -5px; border: none; background: var(--tet-red); color: white; border-radius: 50%; width: 20px; height: 20px; font-size: 10px; cursor: pointer;">✎</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <button class="status-badge orange"
                                                    style="border: none; cursor: pointer; background: #f39c12; color: white;"
                                                    onclick="triggerUpload(@r.EventId)">
                                                Checkin
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-box">
                        <div class="empty-box-icon">📅</div>
                        <p>Chưa đăng ký sự kiện nào</p>
                    </div>
                }
            </div>
        </div>

        <!-- Tab Content: Attendance History -->
        <div id="tab-attendance" class="tab-content-area">
            <div class="table-card">
                @if (Model.Attendances != null && Model.Attendances.Any())
                {
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Sự kiện</th>
                                <th>Thời gian check-in</th>
                                <th>Kết quả</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model.Attendances)
                            {
                                <tr>
                                    <td>@a.Event?.Title</td>
                                    <td>
                                        @if (a.AttendanceTime.HasValue)
                                        {
                                            @a.AttendanceTime.Value.ToString("dd/MM/yyyy HH:mm")
                                        }
                                        else
                                        {
                                            <span style="color: #bdc3c7;">--</span>
                                        }
                                    </td>
                                    <td>
                                        @if (a.IsPresent == true)
                                        {
                                            <span class="status-badge success">✓ Có mặt</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge danger">✗ Vắng</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-box">
                        <div class="empty-box-icon">📋</div>
                        <p>Chưa có dữ liệu điểm danh</p>
                    </div>
                }
            </div>
        </div>

        <!-- Tab Content: Certificates -->
        <div id="tab-certificates" class="tab-content-area">
            <div class="table-card">
                @if (Model.Certificates != null && Model.Certificates.Any())
                {
                    <table class="custom-table">
                        <thead>
                            <tr>
                                <th>Sự kiện</th>
                                <th>Mã chứng nhận</th>
                                <th>Ngày cấp</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cert in Model.Certificates.OrderByDescending(c => c.IssuedAt))
                            {
                                <tr>
                                    <td>@cert.Event?.Title</td>
                                    <td><code
                                            style="background: #f8f9fa; padding: 4px 8px; border-radius: 4px; font-size: 12px;">@cert.CertificateCode</code>
                                    </td>
                                    <td>@cert.IssuedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>
                                        <a href="/Certificates/Details/@cert.CertificateId" class="status-badge success"
                                            style="text-decoration: none;">
                                            📄 Xem & Tải
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="empty-box">
                        <div class="empty-box-icon">🏅</div>
                        <p>Chưa có giấy chứng nhận nào</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script>
    function switchTab(event, tabId) {
        // Remove active class from all tabs
        var tabButtons = document.querySelectorAll('.tab-button');
        tabButtons.forEach(function (btn) {
            btn.classList.remove('active');
        });

        // Hide all tab contents
        var tabContents = document.querySelectorAll('.tab-content-area');
        tabContents.forEach(function (content) {
            content.classList.remove('active');
        });

        // Add active class to clicked tab
        event.currentTarget.classList.add('active');

        // Show selected tab content
        document.getElementById(tabId).classList.add('active');
    }

        const checkInInput = document.createElement('input');
    checkInInput.type = 'file';
    checkInInput.accept = 'image/*';
    checkInInput.capture = 'environment';

       const fileInput = document.createElement('input');
    fileInput.type = 'file';
    fileInput.accept = 'image/*';
    fileInput.capture = 'environment';

    function triggerUpload(eventId) {
        fileInput.onchange = async (e) => {
            const file = e.target.files[0];
            if (!file) return;

            const formData = new FormData();
            formData.append('eventId', eventId);
            formData.append('photo', file);

            const res = await fetch('/Profile/CheckInImageOnly', {
                method: 'POST',
                body: formData
            });

            const data = await res.json();
            if (data.success) {
                alert("Đã cập nhật hình ảnh!");
                location.reload();
            } else {
                alert(data.message);
            }
        };
        fileInput.click();
    }
</script>